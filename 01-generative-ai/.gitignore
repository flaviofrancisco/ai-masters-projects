# Project .gitignore: Jupyter notebook project in PyCharm.
# Python basics are also covered by the repository-root .gitignore.

# ---------------------------------------------------------------
# Environments & secrets
# ---------------------------------------------------------------
.venv/
venv/
env/
.env
.env.*
!.env.example

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ---------------------------------------------------------------
# Jupyter
# ---------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py
.virtual_documents/
.jupyter_ystore.db
*.nbconvert.ipynb

# ---------------------------------------------------------------
# PyCharm / JetBrains
#   Keep shareable project settings, ignore user-specific state.
#   (To ignore the whole folder instead, replace this block with `.idea/`.)
# ---------------------------------------------------------------
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionaries/
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/dataSources.local.xml
.idea/sqldialects.xml
.idea/jupyter-settings.xml
.idea/copilot*
.idea/**/aws.xml
.idea/caches/
.idea/libraries/
.idea/artifacts/
*.iws
out/

# ---------------------------------------------------------------
# Model training outputs (from the notebook)
# ---------------------------------------------------------------
# GRPOTrainer checkpoints (output_dir="outputs")
outputs/
# model.save_lora("grpo_saved_lora")
grpo_saved_lora/
# Unsloth's generated kernels
unsloth_compiled_cache/
wandb/
runs/
*.safetensors
*.bin
*.gguf
*.pt
*.pth

# ---------------------------------------------------------------
# macOS
# ---------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
/.idea/01-generative-ai.iml
/.idea/.gitignore
/.idea/modules.xml
/.idea/inspectionProfiles/profiles_settings.xml
/requirements-mac.txt
/.idea/vcs.xml
